	// shell
	"efm:shellcheck": {
		"selector": "source.shell",
		"enabled": true,
		"command": ["efm-langserver", "-c", "~/share/efm-langserver/shell-shellcheck.yaml"],
		"initialization_options": {
		"env": { "PATH": "/opt/homebrew/bin" },
			"documentFormatting": true,
			"documentRangeFormatting": true,
			"hover": true,
			"documentSymbol": true,
			"codeAction": true,
			"completion": true,
		},
	},
	"efm:shfmt": {
		"command": ["efm-langserver", "-c", "~/share/efm-langserver/shell-shfmt.yaml"],
		"enabled": false,
		"env": { "PATH": "/opt/homebrew/bin" },
		"selector": "source.shell",
		"initialization_options": {
			"documentFormatting": true,
			"documentRangeFormatting": true,
			"codeAction": true,
		},
	},
	"diagnosticls:shellcheck": {
		"command": ["diagnostic-languageserver", "--stdio"],
		"enabled": false,
		"selector": "source.shell.bash",
		"initialization_options": {
			"linters": {
				"shellcheck": {
					"command": "shellcheck",
					"args": ["--format=json", "--external-sources", "-"],
					"debounce": 100,
					"formatLines": 1,
					"offsetLine": 0,
					"offsetColumn": 0,
					"sourceName": "shellcheck",
					"parseJson": {
						"line": "line",
						"column": "column",
						"endLine": "endLine",
						"endColumn": "endColumn",
						"security": "level",
						"message": "\\${message} [\\${code}]",
					},
					"securities": {
						"error": "error",
						"warning": "warning",
						"note": "info",
					},
				},
			},
			"formatters": {},
			"filetypes": {
				"shellscript": "shellcheck",
			},
		},
	},

