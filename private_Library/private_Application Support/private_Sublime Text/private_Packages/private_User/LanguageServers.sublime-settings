{
	// C, C++
	"ccls": {
		"command": ["ccls"],
		"enabled": false,
		"env": { "PATH": "/opt/homebrew/bin" },
		"initialization_options": {
			"cache": {
				"directory": "/tmp/ccls-cache",
			},
			"completion": {
				"detailedLabel": true,
			},
			"clang": {
				"extraArgs": [
					"--query-driver=/opt/homebrew/bin/gcc-*,/opt/homebrew/bin/g++-*",
					// "-isystem",
					// "/Library/Developer/CommandLineTools/usr/include/c++/v1",
				],
				"resourceDir": "/opt/homebrew/opt/llvm/lib/clang/19",
			},
		},
		"selector": "source.c | source.c++ | source.objc | source.objc++ | source.cuda-c++",
	},

	// CMake
	"neocmakelsp": {
		"command": ["neocmakelsp", "stdio"],
		"enabled": true,
		"env": { "PATH": "/opt/homebrew/bin" },
		"selector": "source.cmake",
	},
	"cmake-language-server": {
		"command": ["cmake-language-server"],
		"enabled": true,
		"env": { "PATH": "/opt/homebrew/bin" },
		"selector": "source.cmake",
	},
	"efm:cmake-lint": {
		"command": ["efm-langserver", "-c", "~/share/efm-langserver/cmake-cmake-lint.yaml"],
		"enabled": false,
		"env": { "PATH": "/opt/homebrew/bin" },
		"initialization_options": {
			"codeAction": true,
			"completion": true,
			"documentSymbol": true,
			"hover": true,
		},
		"selector": "source.cmake",
	},
	"efm:gersemi": {
		"command": ["efm-langserver", "-c", "~/share/efm-langserver/cmake-gersemi.yaml"],
		"enabled": false,
		"env": { "PATH": "/opt/homebrew/bin" },
		"initialization_options": {
			"documentFormatting": true,
			"documentRangeFormatting": false,
		},
		"selector": "source.cmake",
	},

	// Containerfile
	"efm:hadolint": {
		"command": ["efm-langserver", "-c", "~/share/efm-langserver/containerfile-hadolint.yaml"],
		"enabled": true,
		"env": { "PATH": "/opt/homebrew/bin" },
		"initialization_options": {
			"codeAction": true,
			"completion": true,
			"documentSymbol": true,
		},
		"selector": "source.containerfile | source.dockerfile",
	},
	"docker": {
		"command": ["docker-language-server", "start", "--stdio"],
		"enabled": true,
		"env": { "PATH": "/opt/homebrew/bin" },
		"initialization_options": {
			"dockercomposeExperimental": {
				"composeSupport:": false,
			},
			"dockerfileExperimental": {
				"removeOverlappingIssues:": true,
			},
			"telemetry": "off",
		},
		"selector": "source.containerfile | source.dockerfile",
	},

	// CSV
	"efm:csvlint": {
		"command": ["efm-langserver", "-c", "~/share/efm-langserver/csv-csvlint.yaml"],
